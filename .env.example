# =============================================================
# AI Meeting Assistant - Environment Variables
# =============================================================
# On Hugging Face Spaces: go to Settings -> Variables and secrets
# and add GROQ_API_KEY there. Do NOT commit a real key to git.

# Groq API key (FREE, no credit card): https://console.groq.com/keys
# This single key powers BOTH Whisper transcription and the LLM summarizer.
GROQ_API_KEY=

# Optional: force a language for transcription (ISO-639-1), e.g. en, hi, es
# TRANSCRIPTION_LANGUAGE=en
